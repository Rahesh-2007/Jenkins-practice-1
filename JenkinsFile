pipeline{
  agent any
  stages{
    stage('Checkout')
      steps{
        git branch: 'main',
        url: 'https://github.com/Rahesh-2007/Jenkins-practice-1.git'
      }
  }
  stage('Compile'){
    steps{
        bat 'javac AddingTwoNums.java'
    }
    stage('Execute'){
        steps{
            bat 'Jenkins-practice-1'
        }
    }
  }
  post{
    sucess{
        echo 'Program Executed Successfully'
    }
    failure{
        echo 'Program Execution Failed'
    }
    always{
        echo 'Pipeline Completed'
    }
  }
}