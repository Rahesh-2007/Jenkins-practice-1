pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Rahesh-2007/Jenkins-practice-1.git'
            }
        }

        stage('Compile') {
            steps {
                bat 'javac AddingTwoNum.java'
            }
        }

        stage('Execute') {
            steps {
                bat 'java AddingTwoNum'
            }
        }
    }

    post {
        success {
            echo 'Program Executed Successfully'
        }

        failure {
            echo 'Program Execution Failed'
        }

        always {
            echo 'Pipeline Completed'
        }
    }
}